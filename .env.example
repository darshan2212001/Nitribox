# Copy to .env. Encode special chars in DB password in DATABASE_URL (e.g. @ -> %40).

# Default database: local MySQL schema `nutribox` on localhost:3306 (MySQL Workbench).
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/nutribox
#
# SQLite (optional): only if you intentionally avoid MySQL
# DATABASE_URL=sqlite:///./nutribox.db
#
# First-time setup: create DB + migrations — python scripts/setup_local_mysql.py  (or npm run db:setup)

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
GOOGLE_MAPS_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081,exp://localhost:8081
WS_HEARTBEAT_INTERVAL=30
ENVIRONMENT=development
API_PORT=8000
# Web client: create client/.env with VITE_API_URL=http://localhost:8000 (match API_PORT above), then restart Vite.
# true = API runs SQLAlchemy create_all + ad-hoc ALTERs on startup (handy for local SQLite).
# false = schema only from Alembic (alembic upgrade head); use after MySQL is migrated — avoids duplicate DDL.
AUTO_CREATE_DB_SCHEMA=true
