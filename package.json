{
  "name": "nutribox-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "mobile"
  ],
  "scripts": {
    "install:all": "npm install --legacy-peer-deps && npm run install:web && npm run install:mobile",
    "install:web": "npm --workspace client install --legacy-peer-deps",
    "install:mobile": "npm --workspace mobile install --legacy-peer-deps",
    "start:api": "python run_api.py",
    "start:web": "npm --workspace client run dev",
    "start:mobile": "npm --workspace mobile run start",
    "start:web-app": "concurrently \"npm run start:api\" \"npm run start:web\"",
    "dev": "npm run start:web-app",
    "dev:all": "concurrently \"npm run start:api\" \"npm run start:web\" \"npm run start:mobile\"",
    "db:recreate": "python scripts/recreate_schema.py",
    "db:migrate": "alembic upgrade head",
    "db:fix-alembic": "python scripts/alembic_fix_stuck_mysql.py",
    "db:setup": "python scripts/setup_local_mysql.py",
    "db:reset-users": "python scripts/reset_users_and_seed_test_accounts.py",
    "test:api": "python -m pytest api/tests -v",
    "clean-install": "npm run clean && npm install --legacy-peer-deps && npm run install:all",
    "clean": "Remove-Item -Path node_modules -Recurse -Force -ErrorAction SilentlyContinue; Remove-Item -Path client/node_modules -Recurse -Force -ErrorAction SilentlyContinue; Remove-Item -Path mobile/node_modules -Recurse -Force -ErrorAction SilentlyContinue"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "overrides": {
    "nutribox-web-client": {
      "@types/react": "^18.2.43",
      "react": "^18.2.0",
      "react-dom": "^18.2.0"
    },
    "zyael-nutribox-mobile": {
      "@types/react": "^18.2.43",
      "react": "18.3.1",
      "react-dom": "18.3.1"
    }
  }
}
